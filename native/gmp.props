<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    GMP dependency configuration for the Visual Studio projects.

    Resolution order
    ─────────────────────────────────────────────────────────────────────────
    1. Conan 2.x  (recommended — generates build\conandeps.props automatically)

         Run conan_setup.ps1 (in this folder) for one-command setup, or see
         CONTRIBUTING.md for the full manual command sequence with options.

       The generated props file is imported and injects include/lib paths via
       its own ItemDefinitionGroup.

    2. Environment variable  GMP_ROOT  pointing to an existing GMP install:

         set GMP_ROOT=C:\path\to\gmp          (current session)
         setx GMP_ROOT C:\path\to\gmp         (persistent — restart VS after)

    3. Local deps folder  native\deps\gmp\  (portable, no env vars):

         Download ShiftMediaProject prebuilt from
           https://github.com/ShiftMediaProject/gmp/releases
         and extract so that:
           native\deps\gmp\include\gmp.h   exists
           native\deps\gmp\lib\x86\gmp.lib exists
           native\deps\gmp\lib\x64\gmp.lib exists

    Supported GMP directory layouts
    ─────────────────────────────────────────────────────────────────────────
    ShiftMediaProject prebuilt:
      <root>\include\gmp.h
      <root>\lib\x86\gmp.lib   (Win32 builds)
      <root>\lib\x64\gmp.lib   (x64 builds)

    Flat layout  (vcpkg, Conan 1.x single-arch cache, manual MSYS2 build):
      <root>\include\gmp.h
      <root>\lib\gmp.lib
  -->

  <!-- ── Conan 2.x: import generated props when available ─────────────── -->
  <Import Project="$(MSBuildThisFileDirectory)build\conandeps.props"
          Condition="exists('$(MSBuildThisFileDirectory)build\conandeps.props')" />

  <!-- ── Header fallback for platforms not yet in the Conan install ──────
       When conandeps.props is present but the Conan-generated ItemDefinitionGroup
       did not match the current platform (e.g. Win32 after an x64-only install),
       import the x64 Release vars file to obtain $(Conangmp_libgmpRootFolder).
       GMP headers are architecture-neutral so compilation will succeed; linking
       Win32 still requires running conan install with -s arch=x86. ──────── -->
  <Import Project="$(MSBuildThisFileDirectory)build\conan_gmp_libgmp_vars_release_x64.props"
          Condition="exists('$(MSBuildThisFileDirectory)build\conandeps.props') and '$(Conangmp_libgmpIncludeDirectories)'=='' and exists('$(MSBuildThisFileDirectory)build\conan_gmp_libgmp_vars_release_x64.props')" />
  <PropertyGroup Condition="'$(Conangmp_libgmpRootFolder)'!='' and '$(GmpIncDir)'==''">
    <GmpIncDir>$(Conangmp_libgmpRootFolder)\include</GmpIncDir>
  </PropertyGroup>

  <!-- ── Manual / env-var fallback (used when Conan props are absent) ──── -->
  <PropertyGroup Condition="!exists('$(MSBuildThisFileDirectory)build\conandeps.props')">

    <!-- Resolve root directory: env var → local deps folder -->
    <GmpRootDir Condition="'$(GmpRootDir)'=='' and '$(GMP_ROOT)'!=''">$(GMP_ROOT)</GmpRootDir>
    <GmpRootDir Condition="'$(GmpRootDir)'==''">$(MSBuildThisFileDirectory)deps\gmp</GmpRootDir>

    <!-- Map MSBuild Win32 platform name to the x86 subfolder name used by ShiftMedia -->
    <GmpLibPlatform Condition="'$(Platform)'=='Win32'">x86</GmpLibPlatform>
    <GmpLibPlatform Condition="'$(Platform)'!='Win32'">$(Platform)</GmpLibPlatform>

    <GmpIncDir>$(GmpRootDir)\include</GmpIncDir>

    <!-- ShiftMedia layout: separate x86 / x64 subdirectories -->
    <GmpLibDir Condition="exists('$(GmpRootDir)\lib\$(GmpLibPlatform)')">$(GmpRootDir)\lib\$(GmpLibPlatform)</GmpLibDir>
    <!-- Flat layout: single lib directory (vcpkg, Conan 1.x, manual) -->
    <GmpLibDir Condition="'$(GmpLibDir)'==''">$(GmpRootDir)\lib</GmpLibDir>

  </PropertyGroup>

</Project>
