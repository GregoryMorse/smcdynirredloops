module

public section

namespace SmcIrred.Data

/-! # Tables 1 and 2 of the paper against the regenerated counts (G38, C60)

`paperAes`/`paperRsa` transcribe the printed Tables 1–2 (`validation/data/paper_tables.json`, hand-transcribed from the
author manuscript and re-read by `validation/check_tables.py`); `regenAes`/`regenRsa` are the counts regenerated by the
native generators with `SMCIRRED_SEED=1` (`validation/data/table_regen.json`, evidence class M).  The theorems compare
the two data sets and check the arithmetic relations between printed numbers; they say nothing about the generators. -/

structure Row where
  bits : Nat
  nodes : Nat
  edges : Nat
  execN : Nat
  execE : Nat

@[expose] def paperAes : List Row :=
  [⟨128, 51127, 222683, 134455, 386203⟩, ⟨192, 61364, 267320, 161489, 463381⟩, ⟨256, 71568, 311924, 188438, 541018⟩]

/-- Regenerated AES counts (bits, nodes, edges, executed nodes).  The executed edge count is not recorded: it varies with
the random dependency order (observed range for AES-256: 541018..541694). -/
@[expose] def regenAes : List (Nat × Nat × Nat × Nat) :=
  [(128, 51127, 222683, 134455), (192, 61364, 267320, 161489), (256, 71568, 311924, 188438)]

@[expose] def paperRsa : List Row :=
  [⟨32, 8882, 16591, 686447, 1321378⟩, ⟨64, 15743, 29925, 4538657, 8706840⟩,
   ⟨128, 34604, 67583, 27372136, 52186545⟩, ⟨256, 88121, 180473, 167967539, 320612875⟩]

@[expose] def regenRsa : List Row :=
  [⟨32, 8882, 16591, 686447, 1321687⟩, ⟨64, 15743, 29925, 4538657, 8686995⟩,
   ⟨128, 34604, 67583, 27372136, 52269807⟩, ⟨256, 88121, 180473, 167967539, 320530894⟩]

/-- Static node and edge counts and the executed node counts agree for every printed row (AES and RSA). -/
theorem static_and_execN_agree :
    (paperAes.zip regenAes).all (fun (p, r) => p.bits == r.1 && p.nodes == r.2.1 && p.edges == r.2.2.1 && p.execN == r.2.2.2) = true ∧
    (paperRsa.zip regenRsa).all (fun (p, r) => p.bits == r.bits && p.nodes == r.nodes && p.edges == r.edges && p.execN == r.execN) = true := by
  decide +kernel

/-- The printed executed edge counts of RSA differ from the regenerated ones by less than 1 %
(the executed edge count depends on the random dependency order of the generator). -/
theorem rsa_execE_close :
    (paperRsa.zip regenRsa).all (fun (p, r) =>
      (if p.execE ≤ r.execE then r.execE - p.execE else p.execE - r.execE) * 100 < r.execE) = true := by
  decide +kernel

/-- Printed AES-128/192/256 rows: key-length order, and the number of nodes and edges grows with the key length. -/
theorem aes_monotone : ∀ p ∈ [(0, 1), (1, 2)], (paperAes.getD p.1 ⟨0, 0, 0, 0, 0⟩).nodes < (paperAes.getD p.2 ⟨0, 0, 0, 0, 0⟩).nodes ∧
    (paperAes.getD p.1 ⟨0, 0, 0, 0, 0⟩).edges < (paperAes.getD p.2 ⟨0, 0, 0, 0, 0⟩).edges := by
  decide +kernel

/-- Printed RSA CFG-generation times (Table 2, column CFG) in hundredths of a second, x86 and x86-64. -/
@[expose] def rsaCfgX86 : List Nat := [490, 3212, 19669, 117136]
@[expose] def rsaCfgX64 : List Nat := [503, 3306, 20102, 122889]

/-- On the printed data the CFG time of RSA more than quadruples whenever the key length doubles,
i.e. the printed times grow faster than quadratically (C61, "worse than quadratic"). -/
theorem rsa_cfg_worse_than_quadratic :
    (List.range 3).all (fun i => decide (4 * rsaCfgX86.getD i 0 < rsaCfgX86.getD (i + 1) 0 ∧ 4 * rsaCfgX64.getD i 0 < rsaCfgX64.getD (i + 1) 0)) = true := by
  decide +kernel

/-- Executed node counts of RSA also more than quadruple per doubling (the executed graph is larger than quadratic). -/
theorem rsa_execN_worse_than_quadratic : ∀ i < 3, 4 * (paperRsa.getD i ⟨0, 0, 0, 0, 0⟩).execN < (paperRsa.getD (i + 1) ⟨0, 0, 0, 0, 0⟩).execN := by
  decide +kernel

end SmcIrred.Data
