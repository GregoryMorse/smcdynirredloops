theorem enc128 : encrypt 10 (aes128 0x102030405060708090a0b0c0d0e0f) (beBytes pt 16) =
    beBytes 0x69c4e0d86a7b0430d8cdb78070b4c55a 16 := by
  rw [aes128_rk]
  refine encrypt_chain 10 rk128 _ _ encS128 (by decide +kernel) (fun i hi => ?_) (by decide +kernel)
  match i, hi with
  | 0, _ => exact enc128_s0
  | 1, _ => exact enc128_s1
  | 2, _ => exact enc128_s2
  | 3, _ => exact enc128_s3
  | 4, _ => exact enc128_s4
  | 5, _ => exact enc128_s5
  | 6, _ => exact enc128_s6
  | 7, _ => exact enc128_s7
  | 8, _ => exact enc128_s8
  | k + 9, h => omega

